# Create an AI Gateway key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Create a Redis database at https://upstash.com/ and copy its REST credentials.
# Required in production for shared per-IP chat rate limiting (10 requests/minute).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

